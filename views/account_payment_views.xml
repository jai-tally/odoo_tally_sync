<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════════
         TallyPrime Sync — Payment Form View Extension
    ══════════════════════════════════════════════════════════════ -->

    <record id="view_account_payment_form_tally" model="ir.ui.view">
        <field name="name">account.payment.form.tally</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Tally status badge in the button box -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_tally_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="tally_sync_status == 'not_synced'">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="tally_sync_status" widget="badge"
                                   decoration-success="tally_sync_status == 'synced'"
                                   decoration-danger="tally_sync_status == 'failed'"
                                   decoration-warning="tally_sync_status == 'skipped'"/>
                        </span>
                        <span class="o_stat_text">Tally</span>
                    </div>
                </button>
            </xpath>

            <!-- Sync button in the action buttons area -->
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_sync_to_tally"
                        string="Sync to Tally"
                        type="object"
                        class="btn-secondary"
                        icon="fa-upload"
                        invisible="state != 'posted'"/>
            </xpath>

            <!-- Tally sync info below the chatter -->
            <xpath expr="//sheet" position="inside">
                <group string="TallyPrime Sync" invisible="tally_sync_status == 'not_synced'">
                    <group>
                        <field name="tally_sync_status" readonly="1"/>
                        <field name="tally_synced_at" readonly="1"/>
                        <field name="tally_sync_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="tally_error" readonly="1" invisible="not tally_error"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Payment list view — add Tally status column -->
    <record id="view_account_payment_list_tally" model="ir.ui.view">
        <field name="name">account.payment.list.tally</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="tally_sync_status" widget="badge" optional="show"
                       decoration-success="tally_sync_status == 'synced'"
                       decoration-danger="tally_sync_status == 'failed'"
                       decoration-muted="tally_sync_status == 'not_synced'"/>
            </xpath>
        </field>
    </record>
</odoo>
