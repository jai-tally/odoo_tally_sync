<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ══════════════════════════════════════════════════════════════
         Scheduled Cron: Retry Failed Tally Sync Logs every 5 minutes
    ══════════════════════════════════════════════════════════════ -->

    <record id="ir_cron_tally_retry_failed" model="ir.cron">
        <field name="name">TallyPrime: Retry Failed Sync Logs</field>
        <field name="model_id" ref="model_tally_sync_log"/>
        <field name="state">code</field>
        <field name="code">model.cron_retry_failed()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
